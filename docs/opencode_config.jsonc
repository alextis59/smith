{
  "$schema": "https://opencode.ai/config.json",

  "model": "mygateway-openai/gpt-5.2",
  "small_model": "mygateway-openai/gpt-5-mini",

  "enabled_providers": [
    "mygateway-openai",
    "mygateway-anthropic"
  ],

  "provider": {
    "mygateway-openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "My Gateway OpenAI Schema",
      "options": {
        "baseURL": "https://YOUR_GATEWAY_HOST/openai/v1",
        "apiKey": "{env:MY_GATEWAY_API_KEY}",
        "timeout": 600000,
        "chunkTimeout": 30000,
        "setCacheKey": true
      },
      "models": {
        "gpt-5.2": {
          "name": "GPT-5.2",
          "limit": {
            "context": 128000,
            "output": 65536
          },
          "options": {
            "reasoningEffort": "medium",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          }
        },
        "gpt-5-mini": {
          "name": "GPT-5 Mini",
          "limit": {
            "context": 128000,
            "output": 32768
          },
          "options": {
            "reasoningEffort": "low",
            "textVerbosity": "low"
          }
        },
        "gpt-5-nano": {
          "name": "GPT-5 Nano",
          "limit": {
            "context": 128000,
            "output": 16384
          },
          "options": {
            "reasoningEffort": "minimal",
            "textVerbosity": "low"
          }
        }
      }
    },

    "mygateway-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "My Gateway Anthropic Schema",
      "options": {
        "baseURL": "https://YOUR_GATEWAY_HOST/anthropic/v1",
        "apiKey": "{env:MY_GATEWAY_API_KEY}",
        "timeout": 600000,
        "chunkTimeout": 30000,
        "setCacheKey": true
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "options": {
            "thinking": { "type": "adaptive" },
            "output_config": { "effort": "medium" }
          }
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "options": {
            "thinking": { "type": "adaptive" },
            "output_config": { "effort": "high" }
          }
        },
        "claude-haiku-4-5": {
          "name": "Claude Haiku 4.5",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    }
  },

  "agent": {
    "build": {
      "model": "mygateway-openai/gpt-5.2",
      "temperature": 0.2,
      "steps": 40
    },

    "explore": {
      "model": "mygateway-openai/gpt-5-mini",
      "temperature": 0,
      "steps": 10,
      "tools": {
        "write": false,
        "edit": false
      }
    },

    "scout": {
      "model": "mygateway-openai/gpt-5-nano",
      "temperature": 0,
      "steps": 6,
      "tools": {
        "write": false,
        "edit": false
      }
    },

    "plan": {
      "model": "mygateway-anthropic/claude-sonnet-4-6",
      "temperature": 0.1,
      "steps": 14,
      "tools": {
        "write": false,
        "edit": false
      }
    },

    "review": {
      "mode": "subagent",
      "model": "mygateway-anthropic/claude-sonnet-4-6",
      "temperature": 0.1,
      "steps": 12,
      "tools": {
        "write": false,
        "edit": false
      }
    },

    "hard-debug": {
      "mode": "subagent",
      "model": "mygateway-anthropic/claude-opus-4-8",
      "temperature": 0.1,
      "steps": 18,
      "tools": {
        "write": false,
        "edit": false
      }
    }
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "coverage/**",
      ".next/**",
      ".turbo/**",
      ".cache/**",
      "tmp/**"
    ]
  }
}
