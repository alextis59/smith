{
  "$schema": "https://opencode.ai/config.json",

  // Default model for normal coding/build work
  "model": "openai/gpt-5.2",

  // Used for lightweight tasks such as title generation
  "small_model": "openai/gpt-5-mini",

  "provider": {
    "openai": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 30000,
        "setCacheKey": true
      },
      "models": {
        "gpt-5.2": {
          "options": {
            "reasoningEffort": "medium",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          },
          "variants": {
            "cheap": {
              "reasoningEffort": "low",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "hard": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          }
        },
        "gpt-5.1-codex": {
          "options": {
            "reasoningEffort": "medium",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-5-mini": {
          "options": {
            "reasoningEffort": "low",
            "textVerbosity": "low"
          }
        },
        "gpt-5-nano": {
          "options": {
            "reasoningEffort": "minimal",
            "textVerbosity": "low"
          }
        }
      }
    },

    "anthropic": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 30000,
        "setCacheKey": true
      },
      "models": {
        "claude-sonnet-4-5": {
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8000
            }
          },
          "variants": {
            "cheap": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 2000
              }
            },
            "hard": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 16000
              }
            }
          }
        },
        "claude-opus-4-5": {
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          }
        },
        "claude-haiku-4-5": {}
      }
    }
  },

  "agent": {
    "build": {
      "model": "openai/gpt-5.2",
      "temperature": 0.2,
      "steps": 40
    },

    "plan": {
      "model": "anthropic/claude-sonnet-4-5",
      "temperature": 0.1,
      "steps": 12,
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },

    "explore": {
      "model": "openai/gpt-5-mini",
      "temperature": 0,
      "steps": 8,
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },

    "scout": {
      "model": "openai/gpt-5-mini",
      "temperature": 0,
      "steps": 8,
      "permission": {
        "edit": "deny"
      }
    },

    "general": {
      "model": "openai/gpt-5.2",
      "temperature": 0.2,
      "steps": 20
    },

    "review": {
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-5",
      "temperature": 0.1,
      "steps": 12,
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },

    "hard-debug": {
      "mode": "subagent",
      "model": "anthropic/claude-opus-4-5",
      "temperature": 0.1,
      "steps": 16,
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "coverage/**",
      ".next/**",
      ".turbo/**"
    ]
  }
}
